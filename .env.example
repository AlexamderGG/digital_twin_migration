# =============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO
# Copiar este archivo como .env y completar los valores
# =============================================================================

# --- Conexión a Base de Datos PostgreSQL/PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_twin_migration
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui

# --- Seguridad ---
SECRET_KEY=tu_clave_secreta_super_segura_aqui_cambiar_en_produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Configuración de la Aplicación ---
APP_NAME=Gemelo Digital de Corredores de Migración
APP_VERSION=1.0.0
DEBUG=True

# --- Directorios ---
DATA_DIR=./data
OUTPUTS_DIR=./outputs
TEMP_DIR=./temp

# --- Fuentes de Datos Externas ---
# GBIF (opcional para descarga automática)
GBIF_USER=
GBIF_EMAIL=

# WorldClim / CMIP6 - no requiere autenticación básica
WORLDCLIM_BASE_URL=https://geodata.ucdavis.edu/climate/worldclim

# --- Parámetros por Defecto ---
DEFAULT_CRS=EPSG:4326
DEFAULT_YEAR_START=2024
DEFAULT_YEAR_END=2050
